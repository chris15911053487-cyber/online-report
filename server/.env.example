# 服务端使用 Node 官方生态常用的 mssql 包（Tedious/TDS）连接 SQL Server。
# 不要把本文件复制进 docker-compose.yml；部署用单独 env 文件（勿提交仓库）。
#
# Docker 部署默认加载：项目内 server/.env
# 也可用单独路径（推荐生产）：DEPLOY_ENV_FILE=/etc/online-report/app.env docker compose -f docker-compose.deploy.yml up -d
#
# 根目录 docker-compose.yml 仅为可选本地 MySQL，与 SQL Server 生产库无关。

NODE_ENV=development
PORT=3000
JWT_SECRET=please-use-a-long-random-string
JWT_EXPIRES_IN=7d

# 管理员 OUSR 用户代码（逗号或中文逗号分隔）。仅这些账号 role=admin，可访问菜单设置等接口。
# ADMIN_USER_CODES=manager01,sapadmin

# 登录：表 OUSR（USER_CODE / MobileIMEI / U_NAME）；报工表由 sql/schema-mssql.sql + init-db 建在同一库。
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=your_user
# 密码含 # @ & * 等时务必加双引号，否则 # 会被当成注释截断，例如：
# DB_PASSWORD="KT@2006#sap*&Ppm"
DB_PASSWORD=your_password
DB_NAME=your_database
DB_POOL=10

# 是否在 500 时把服务端错误详情返回给前端（生产可关）。不设时：非 production 会暴露详情。
# EXPOSE_SERVER_ERRORS=true

# 加密：默认关闭（DB_ENCRYPT 不设或 false），避免旧库只支持明文 TDS 时出现 SSL unsupported protocol。
# Azure/强制 TLS 时再设：DB_ENCRYPT=true，并通常配合 DB_TRUST_SERVER_CERTIFICATE=true
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true

# 连接/请求超时（毫秒）
# DB_CONNECT_TIMEOUT_MS=15000
# DB_REQUEST_TIMEOUT_MS=30000

# 连接失败重试（容器启动快于 SQL Server 时有用）
# DB_CONNECT_RETRIES=3
# DB_CONNECT_RETRY_DELAY_MS=1000

# SQL Server 中显示的应用程序名（sys.dm_exec_sessions.program_name）
# DB_APP_NAME=online-report

# 领料出库批次库存校验（POST /returnpro/batch-stock）：默认查 SAP OIBT（ItemCode+BatchNum+WhsCode）；可改为自定义存储过程
# RETURNPRO_BATCH_STOCK_PROC=Z_ONLINE_RETURNPRO_BATCH_STOCK

# ---------- 返修领料 → SAP B1 WCF（POST /returnpro/pick：Login + AddObject）----------
# Web 服务根地址（勿以 / 结尾）；示例：http://172.17.62.82:8011/B1Service.svc/Web
# RETURNPRO_B1_BASE_URL=http://172.17.62.82:8011/B1Service.svc/Web
# AddObject 对象类型（领料出库常用 oInventoryGenExit；以贵司 B1 封装为准）
# RETURNPRO_B1_OBJECT_TYPE=oInventoryGenExit
# RETURNPRO_B1_TIMEOUT_MS=60000
# RETURNPRO_B1_SESSION_TTL_MS=1500000
# RETURNPRO_B1_BPL_ID=1
# 若抬头需要业务伙伴（部分单据类型必填）：
# RETURNPRO_B1_CARD_CODE=
# RETURNPRO_B1_CARD_NAME=
#
# B1 Login（未单独配置时，数据库四项可复用 DB_HOST / DB_NAME / DB_USER / DB_PASSWORD）
# B1_DATABASE_SERVER=数据库服务器地址
# B1_DATABASE_NAME=SBO_GFBS_20200111
# B1_DATABASE_TYPE=1
# B1_DATABASE_USER=sa
# B1_DATABASE_PASSWORD=
# B1_COMPANY_USER=manager
# B1_COMPANY_PASSWORD=
# B1_LANGUAGE=ln_Chinese
# B1_LICENSE_SERVER=许可证服务器:40000
# B1_PORT=30015

# 可配置报表（POST /reports/run）：仅作用于动态 SQL，与上面 DB_REQUEST_TIMEOUT_MS（池内默认请求超时）独立
# REPORT_MAX_ROWS=2000
# REPORT_QUERY_TIMEOUT_MS=60000

# 启动时自动创建 nav_menu_items 表（需 DB 账号有建表权限）。无权限时改为 false 并手动执行 sql/migrate-nav-menu-items-only.sql
# AUTO_CREATE_NAV_MENU_TABLE=true

# 登录页「安卓下载」：固定链接 GET /download/android-app.apk（与磁盘上 APK 原始文件名无关）
#
# 【推荐 · Docker】做法 B：构建镜像前放置文件，无需配置 APK_PATH
#   将安装包复制为：server/public/apk/android-app.apk（文件名必须叫 android-app.apk）
#   再 docker compose -f docker-compose.deploy.yml up -d --build
#   镜像内路径为 /app/public/apk/android-app.apk，node 用户可读。仓库已 gitignore：server/public/apk/*.apk
#
# 服务端按顺序使用第一个「存在且非空」的文件：
#   1) APK_PATH（完整路径，优先级最高；可与做法 B 二选一）
#   2) server/public/apk/android-app.apk（做法 B）
#   3) APK_SHARE_ROOT + APK_FILENAME（默认 /root/apk-share + 手机报工1.0.apk；Docker 内 node 用户通常读不到 /root）
#
# 若不用做法 B、而 APK 在宿主机非 /root 目录，可挂载并设 APK_PATH，例如：
#   volumes: [ "/srv/apk/手机报工1.0.apk:/srv/apk/手机报工1.0.apk:ro" ]
# APK_PATH=/srv/apk/手机报工1.0.apk
# APK_SHARE_ROOT=/srv/apk
# APK_FILENAME=手机报工1.0.apk

# 仅 npm run init-db：建报工表、示例订单（登录以 OUSR 为准）

# ============= AI 配置（多模型支持） =============
# 支持 OpenAI、Grok(xAI)、Anthropic、Ollama、本地模型等
# 在菜单管理中配置的 ai_prompt 将与这里的环境变量结合使用

AI_PROVIDER=openai                  # 可选值: openai | grok | deepseek | anthropic | ollama | azure-openai
AI_DEFAULT_MODEL=gpt-4o-mini        # 根据 provider 选择：gpt-4o-mini, grok-2, deepseek-chat, claude-3-haiku 等
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=6000
AI_TIMEOUT_MS=45000

# 根据选择的 provider 填写对应 Key（生产环境强烈建议使用专用 .env 文件，不要提交到 git）
# OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# GROK_API_KEY=xai-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
# ---------- DeepSeek（OpenAI 兼容，国内常用）----------
# 在 https://platform.deepseek.com 创建 API Key 后填入：
# AI_PROVIDER=deepseek
# AI_DEFAULT_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 一般无需改；若官方文档变更 endpoint 可显式指定：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
#
# 可选模型：deepseek-chat（对话）、deepseek-reasoner（深度推理，较慢）
# ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OLLAMA_HOST=http://localhost:11434   # 本地模型时使用

# Azure OpenAI 专用配置（如果使用 AZURE_OPENAI）
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=...

# 可选：自定义 Prompt 目录（高级）
# AI_PROMPT_DIR=./prompts

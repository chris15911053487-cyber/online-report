# ai-agent 服务环境变量。复制为 ai-agent/.env 并填写。

# 主后端回调地址（compose 内网服务名）
AI_BACKEND_URL=http://app:3000

# 与主后端 server/.env 中 AI_SCOPED_SECRET 必须完全一致（用于校验 scoped token）
AI_SCOPED_SECRET=please-set-a-long-random-shared-secret

# LLM provider 与密钥（与主项目 ai.js 约定一致）
AI_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-chat
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=45000

# 按所选 provider 至少配置一个
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# LangGraph 中断/恢复 checkpoint 持久化（挂载到卷）
AI_CHECKPOINT_DB=/data/checkpoints.sqlite

# Skill 正文总字数 ≤ 该值时全量写入 system prompt；超过后只放「名称+描述」索引，命中后用 load_skill 按需加载。
# 0 = 始终按需加载；-1 = 始终全量内联
# AI_SKILL_INLINE_MAX_CHARS=12000

# run_sql 交给模型的最大行数（默认 50，建议 30~50；越少每轮越快，总览请让模型在 SQL 里聚合）
# AI_SQL_LLM_MAX_ROWS=50

# 流式响应附带 token 用量，用于在「执行过程」里显示每次模型调用的输入 tokens。OpenAI/DeepSeek 支持，默认关闭
# AI_STREAM_USAGE=false

# 联网检索（Tavily）：web_search / url_fetch 工具依赖。https://app.tavily.com 创建
TAVILY_API_KEY=
# WEB_SEARCH_MAX_RESULTS=10
# URL_FETCH_MAX_CHARS=100000

PORT=8080

# ============================================================
# ai-agent 服务配置（示例：DeepSeek）
# 本文件已被 .gitignore 忽略，不会提交到 git。
# ============================================================

# ---------- 回调主后端 ----------
# docker-compose 部署时用内网服务名（compose 已注入 AI_BACKEND_URL=http://app:3000，可不填）。
# 若 ai-agent 不在 compose 里、而是本机直跑，改成主后端实际地址，例如：
#   AI_BACKEND_URL=http://127.0.0.1:3000
AI_BACKEND_URL=http://127.0.0.1:3000

# ---------- 共享 scoped 密钥（最关键）----------
# 必须与主后端 server/.env 里的 AI_SCOPED_SECRET 一模一样，否则 Agent 校验 token 会全部失败。
# 下面是用 `openssl rand -hex 32` 生成的示例值，请把同一串也写进 server/.env。
AI_SCOPED_SECRET=e6679b888091f4ae961adb1205df792ee832de11b9d68811e7ef631c0931cf19

# ---------- LLM provider（示例用 DeepSeek，国内可直连）----------
AI_PROVIDER=deepseek
AI_DEFAULT_MODEL=
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=45000

# 在 https://platform.deepseek.com 创建后填入（必填，否则 LLM 调不通）
DEEPSEEK_API_KEY=sk-a1635d158e0347bc93c23e718abad5e8e
# 一般无需改；官方变更 endpoint 时才指定
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 如改用 OpenAI / Grok，把 AI_PROVIDER 换成 openai / grok，并填对应 Key：
# OPENAI_API_KEY=
# GROK_API_KEY=

# ---------- 中断/恢复 checkpoint 持久化 ----------
# compose 已把 /data 挂到命名卷 ai_agent_data，保持默认即可。
AI_CHECKPOINT_DB=/data/checkpoints.sqlite

PORT=8080
